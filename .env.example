# Copia este archivo como .env.local y completa con los datos de
# Supabase → Project Settings → API. SOLO la clave publicable (nunca service_role).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# CAPTCHA OPCIONAL (protección del REGISTRO de cuentas). Déjalo vacío para desactivarlo.
# OJO: si lo activas en Supabase (Authentication → Attack Protection) sin actualizar el código, el inicio de sesión y la
# recuperación de contraseña dejarían de funcionar: hoy el cliente envía el token solo en el registro.
# Requiere ampliar la CSP de vercel.json (ver README, sección CAPTCHA).
VITE_CAPTCHA_PROVIDER=
VITE_CAPTCHA_SITE_KEY=

# Responsable del tratamiento (aparece en el aviso de privacidad y en el consentimiento)
VITE_RESPONSABLE_NOMBRE=
VITE_RESPONSABLE_CORREO=
