  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@playwright/test": "~1.56.1",
    "@vitejs/plugin-vue": "~6.0.1",
    "eslint": "~9.39.5",
    "eslint-plugin-security": "~3.0.1",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "~16.5.0",
    "vite": "~7.3.6",
    "vitest": "~3.2.7",
    "vue-eslint-parser": "~10.4.0"
